# ──────────────────────────────────────────────────────────────────────────────
# 1. CENTRAL BACKEND API CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# Development (Android Emulator):
#   API_BASE_URL=http://10.0.2.2:8000/api
#
# Development (Physical Android Device over Wi-Fi / LAN):
#   API_BASE_URL=http://192.168.1.100:8000/api
#
# Production:
#   API_BASE_URL=https://api.mosje-inspection.gov.in/api
API_BASE_URL=http://10.0.2.2:8000/api

# ──────────────────────────────────────────────────────────────────────────────
# 2. SUPABASE INTEGRATION (Client-Side Public Anon Key Only)
# ──────────────────────────────────────────────────────────────────────────────
# NEVER place SUPABASE_SERVICE_ROLE_KEY in the mobile application.
SUPABASE_URL=https://ctmkpwwbdexwkakuqpat.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN0bWtwd3diZGV4d2tha3VxcGF0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2MDk4MDAsImV4cCI6MjEwNDE4NTgwMH0.ilxOvgsxXQoD3Rh6pZgmfiEMET5u3RtS-B0W_kOEhLU

# ──────────────────────────────────────────────────────────────────────────────
